# Prisma uses these Postgres connection strings. For a Supabase deployment,
# copy the string from the project's Connect dialog and replace [YOUR-PASSWORD].
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Never leave this on for a shared database. The seed script deletes demo data
# before recreating it.
ALLOW_DB_RESET="false"

# Change this value when you want a different random demo dataset. Keep it the
# same when teammates need identical seeded records for debugging.
SEED_RANDOM_SEED="2026-spring-demo"

# Public demo credentials are intentionally visible in preview deployments.
# Use only with disposable demo data and never reuse either value elsewhere.
NEXT_PUBLIC_DEMO_PASSWORD="replace-with-a-demo-only-password"

# Required by `pnpm db:seed`. This value is server-side only and must be unique.
# The seed script refuses to run without it and never prints it.
SEED_ADMIN_PASSWORD="replace-with-a-strong-unique-admin-password"

# NextAuth/Auth.js values are still placeholders at this stage. Replace them
# before any real login flow or deployment. These URLs also seed absolute links
# for external alert digests.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-64-char-secret"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-random-64-char-secret"

# Stage 7 security controls. Keep these off by default for preview environments,
# then enable them gradually when SMTP and Turnstile are configured.
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
AUTH_ENABLE_CAPTCHA="false"
AUTH_EMAIL_VERIFICATION_TTL_HOURS="24"
AUTH_PASSWORD_RESET_TTL_MINUTES="120"
PASSWORD_BCRYPT_ROUNDS="12"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Supabase now exposes publishable keys. Keep the older ANON variable as a
# compatibility fallback until the client layer is wired in Stage 2.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_ANON_KEY=""

# Only needed for trusted server-side admin actions. Never expose this key in
# client code or browser-visible bundles.
SUPABASE_SERVICE_ROLE_KEY=""

# Alert delivery settings. Leave blank if you only want the in-dashboard alert
# experience, or fill one or more channels to enable stand-alone delivery.
EMAIL_SERVER=""
EMAIL_FROM="SWUFE HotelSim <noreply@example.com>"
ALERT_EMAIL_TO=""
ALERT_WEBHOOK_URL=""
ALERT_WEBHOOK_BEARER_TOKEN=""
ALERT_SLACK_WEBHOOK_URL=""

# Read-only Prisma queries retry automatically to smooth over transient
# Supabase pooler hiccups. Writes are intentionally not retried.
PRISMA_READ_RETRY_ATTEMPTS="3"
PRISMA_READ_RETRY_DELAY_MS="250"

# Disposable Playwright mutation flows are intentionally opt-in because they
# mutate seeded business state. Only turn these on right after reseeding a
# throwaway environment.
E2E_ALLOW_MUTATION="false"
E2E_EXPECT_FRESH_SEED="false"
